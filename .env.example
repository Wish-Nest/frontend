# ------------------------------------------------------------------
# BUILD TIME (figées dans le bundle Vite, uniquement pour le dev local)
# Ne les utilisez PAS pour configurer un déploiement Docker :
# une fois l'image construite, elles ne plus changer.
# ------------------------------------------------------------------
REACT_APP_API_BASE_URL=http://localhost:3001/api
REACT_APP_FRONT_URL=http://localhost:3000
REACT_APP_VAPID_PUBLIC_KEY=<public_key>

# ------------------------------------------------------------------
# RUNTIME (conteneur Docker) : lues par entrypoint.sh à CHAQUE démarrage
# et injectées dans le bundle via /config.js -> window.__ENV__.
# Exemples :
#   docker run -e API_BASE_URL=https://api.exemple.fr/api wishnest-front
#   docker run -e VAPID_PUBLIC_KEY=<public_key> wishnest-front
# ------------------------------------------------------------------
# API_BASE_URL=/api          # défaut : /api (même origine que le frontend)
# VAPID_PUBLIC_KEY=<public_key>
